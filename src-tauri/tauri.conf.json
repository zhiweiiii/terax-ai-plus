{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terax",
  "version": "1.0.2",
  "identifier": "app.crynta.terax",
  "build": {
    "beforeDevCommand": "pnpm build:cli:dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:cli && pnpm build:web && pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Terax",
        "width": 800,
        "height": 600,
        "minWidth": 420,
        "minHeight": 280,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost blob:; media-src 'self' asset: https://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; frame-src 'self' http: https: asset: https://asset.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/terax-cli"
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "copyright": "Copyright 2026 Crynta",
    "license": "Apache-2.0",
    "publisher": "Crynta",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "AI-native terminal emulator",
    "longDescription": "Terax, an open-source terminal workspace with multi-tab, file explorer, code editor, web preview, and coding agent integration.",
    "fileAssociations": [
      {
        "name": "Terax Document",
        "role": "Editor",
        "mimeType": "text/plain",
        "ext": [
          "json",
          "jsonc",
          "txt",
          "log",
          "csv",
          "tsv",
          "md",
          "markdown",
          "mdx",
          "js",
          "mjs",
          "cjs",
          "jsx",
          "ts",
          "tsx",
          "mts",
          "cts",
          "java",
          "kt",
          "kts",
          "gradle",
          "py",
          "rb",
          "php",
          "go",
          "rs",
          "swift",
          "dart",
          "lua",
          "c",
          "h",
          "cpp",
          "cc",
          "hpp",
          "hh",
          "cs",
          "html",
          "htm",
          "css",
          "scss",
          "sass",
          "less",
          "vue",
          "svelte",
          "xml",
          "yaml",
          "yml",
          "toml",
          "ini",
          "cfg",
          "conf",
          "properties",
          "sh",
          "bash",
          "zsh",
          "sql",
          "graphql",
          "proto"
        ]
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/zhiweiiii/terax-ai-plus/releases/latest/download/latest.json"
      ]
    }
  }
}
